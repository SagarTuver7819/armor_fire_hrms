# =====================================================
# Armor Fire HRMS - Environment Template
# Copy this file to ".env" and edit values.
#   Local:  copy .env.example → .env
#   Live:   copy .env.example → .env  (server pe alag values)
# NEVER commit real .env to git.
# =====================================================

# local | production
APP_ENV=local

# Full site URL (no trailing slash)
# Local XAMPP example:
APP_URL=http://localhost/armor_new_hrms
# Live subdomain example:
# APP_URL=https://hrms.yourdomain.com

# URL path prefix (no trailing slash)
# Local folder under htdocs:
APP_BASE_PATH=/armor_new_hrms
# Live subdomain document root = project root → leave EMPTY:
# APP_BASE_PATH=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=armor_hrms
DB_USER=root
DB_PASS=

# Optional display timezone
APP_TIMEZONE=Asia/Kolkata
